## Project definition ##########################################################

# Main program
PROJECT := 

# Test program (Google Test)
TESTPROJECT := test_binarytree

# Modules used in main and test program (pure C)
MODULES := binary_tree binary_tree_traversal generic_list allocator  generic_list_functions higher_order_function_demo int_string_dictionary

# Test sources (C++ test support and test cases)
TEST_MODULES := test_binarytree_implementation test_binarytree_api test_binarytree_traversal test_generic_list test_generic_list_functions test_higher_order_function_demo test_int_string_dictionary

## Derived sources #############################################################

# Sources
SRC_MODULES  := $(MODULES:=.c)
SRC_PROJECT  := $(PROJECT).c $(SRC_MODULES)             # C program
SRC_TEST_CPP := $(TEST_MODULES:=.cpp) $(TESTPROJECT).cpp

# Directories
BUILD_DIR := build
BIN_DIR   := bin

## Toolchain ###################################################################

CC       := gcc
CXX      := g++
CFLAGS   := -Wall -Wextra -O0 -g -MMD -MP
CXXFLAGS := -Wall -Wextra -O0 -g -MMD -MP -std=c++17

# Google Test built locally
GTEST_ROOT := googletest
GTEST_INC  := -I$(GTEST_ROOT)/include -I$(GTEST_ROOT)
GTEST_SRC  := $(GTEST_ROOT)/src/gtest-all.cc
GTEST_MAIN := $(GTEST_ROOT)/src/gtest_main.cc
GTEST_OBJS := $(BUILD_DIR)/gtest-all.o $(BUILD_DIR)/gtest_main.o
# pthread is required by gtest
GTEST_LIBS := -pthread

# Add gtest includes to all C/C++ compilations (harmless for C files)
CPPFLAGS += $(GTEST_INC)

## Objects (in build/) #########################################################

# Main program objects (all C)
OBJ_PROJECT := $(patsubst %.c,$(BUILD_DIR)/%.o,$(SRC_PROJECT))

# Test objects: C++ object for the test file + C objects for the modules
OBJ_TEST := $(patsubst %.cpp,$(BUILD_DIR)/%.o,$(SRC_TEST_CPP)) \
			$(patsubst %.c,$(BUILD_DIR)/%.o,$(SRC_MODULES)) \
			$(GTEST_OBJS)

# Dependency files (generated by -MMD -MP next to the .o files)
DEPS := $(OBJ_PROJECT:.o=.d) $(OBJ_TEST:.o=.d)

## Phony targets ###############################################################

.PHONY: all clean test doc dirs $(PROJECT) $(TESTPROJECT)

all: $(PROJECT) $(TESTPROJECT)

# User-facing aliases so `make incomeTax` / `make test_taxation` work
$(PROJECT):     $(BIN_DIR)/$(PROJECT)
$(TESTPROJECT): $(BIN_DIR)/$(TESTPROJECT)

## Link targets (in bin/) ######################################################

$(BIN_DIR)/$(PROJECT): $(OBJ_PROJECT) | dirs
	$(CC)  $(CFLAGS)   -o $@ $^

$(BIN_DIR)/$(TESTPROJECT): $(OBJ_TEST) | dirs
	$(CXX) $(CXXFLAGS) -o $@ $^ $(GTEST_LIBS)

## Convenience #################################################################

test: $(BIN_DIR)/$(TESTPROJECT)
	$<

doc:
	doxygen Doxyfile

dirs:
	mkdir -p $(BUILD_DIR) $(BIN_DIR)

## Compile rules (emit .o and .d into build/) ##################################

# Compile C sources
$(BUILD_DIR)/%.o: %.c | dirs
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

# Compile C++ sources
$(BUILD_DIR)/%.o: %.cpp | dirs
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -c $< -o $@

# Compile .cc sources (used by Google Test)
$(BUILD_DIR)/%.o: %.cc | dirs
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -c $< -o $@

# Explicit rules for Google Test objects (ensures correct paths)
$(BUILD_DIR)/gtest-all.o: $(GTEST_SRC) | dirs
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -c $< -o $@

$(BUILD_DIR)/gtest_main.o: $(GTEST_MAIN) | dirs
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -c $< -o $@

## Auto-included header dependencies ##########################################

-include $(DEPS)

## Clean #######################################################################

clean:
	$(RM) -r $(BUILD_DIR) $(BIN_DIR)
